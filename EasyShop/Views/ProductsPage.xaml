<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:EasyShop.Models"
             xmlns:vm="clr-namespace:EasyShop.ViewModels"
             x:Class="EasyShop.Views.ProductsPage"
             x:DataType="vm:ProductsViewModel"
             Title="Produtos (NoSQL)">
    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">
        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <Label Text="Novo produto" FontSize="20" FontAttributes="Bold" />
            <Entry Placeholder="Nome" Text="{Binding Name}" />
            <Entry Placeholder="Preço (ex.: 129,90)" Keyboard="Numeric" Text="{Binding Price}" />
            <Entry Placeholder="Categoria (opcional)" Text="{Binding Category}" />
            <Entry Placeholder="Atributos (opcional): Cor=Azul; Tamanho=M" Text="{Binding Attributes}" />
            <Button Text="Salvar produto" Command="{Binding SaveCommand}" />
            <Label Text="{Binding Status}" FontSize="13" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Products}">
            <CollectionView.EmptyView>
                <Label Text="Nenhum produto cadastrado." HorizontalOptions="Center" Margin="0,24" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Product">
                    <Border Padding="12" Margin="0,4" StrokeShape="RoundRectangle 10">
                        <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                            <Label Grid.Row="0" Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding PriceText}" FontAttributes="Bold"
                                   VerticalOptions="Center" />
                            <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Text="Excluir"
                                    FontSize="12" Padding="8,0" HeightRequest="36"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProductsViewModel}}, Path=DeleteCommand}"
                                    CommandParameter="{Binding .}" />
                            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Category}" FontSize="12" />
                            <Label Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding AttributesText}" FontSize="13" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
